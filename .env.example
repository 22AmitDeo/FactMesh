# Fact Knowledge Layer Environment Configuration

# Primary LLM: Groq (free tier, fast Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM: Google Gemini (Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Embeddings: Local HuggingFace sentence transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Processing Settings
DATABASE_URL=sqlite:///./factmesh.db
UPLOAD_DIR=./data/uploads
MAX_CONCURRENT_PAGES=3
SIMILARITY_THRESHOLD=0.50
TOP_K_CANDIDATES=5
